# ============================================================
# Meow Khiao — .gitignore สำหรับโปรเจกต์ Ren'Py
# ============================================================

# โฟลเดอร์ที่ Ren'Py เขียนไฟล์ระหว่างรัน (สร้างใหม่ได้เสมอ)
/game/saves/
/game/cache/
/game/tl/None/

# ไฟล์สคริปต์ที่คอมไพล์แล้ว (Ren'Py สร้างใหม่จาก .rpy อัตโนมัติ)
/game/**/*.rpyc
/game/**/*.rpymc
/game/**/*.rpyb

# ไฟล์ที่ Ren'Py สร้างเอง
/game/**/*.bak
/game/**/*.new
/game/**/*.old

# ไฟล์ error / log / ผลลัพธ์ชั่วคราว
/errors.txt
/files.txt
/image_cache.txt
/log.txt
/save_dump.txt
/traceback.txt

# ไฟล์ที่ Ren'Py Launcher สร้าง
/dialogue.tab
/dialogue.txt
/strings.json

# การตั้งค่าเฉพาะเครื่อง / editor
.vscode/
.idea/

# ไฟล์ระบบปฏิบัติการ
Thumbs.db
Desktop.ini
.DS_Store

# ============================================================
# วิดีโอขนาดใหญ่ — ไม่เก็บใน Git (เกินลิมิต GitHub 100MB/ไฟล์)
# ดาวน์โหลดจาก OneDrive แล้ววางกลับตามโครงสร้างเดิม (ดู README.md)
# กติกา: ไม่เก็บเฉพาะไฟล์วิดีโอ .ogv แต่ยังคงโครงสร้างโฟลเดอร์ไว้
# ============================================================
/game/videos/**/*.ogv
